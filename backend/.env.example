# Copy to backend/.env. Everything has a working local default except S3 (uploads stay in memory without it).
NODE_ENV=development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/jobportal
# At least 32 characters in production: openssl rand -hex 32
JWT_SECRET=
CORS_ORIGINS=http://localhost:5173
# Fill an empty database with demo accounts and jobs on start
SEED_ON_START=true
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
